//###################################################################
// MATRICES
//
// Matrices coming from application (Maya)
//###################################################################
//#define PI = 3.14159265359



uniform mat4 WorldViewProjection : WorldViewProjection < string UIWidget="None"; >;
uniform mat4 WorldInverseTranspose : WorldInverseTranspose < string UIWidget="None"; >;
uniform mat4 ViewInverse : ViewInverse < string UIWidget="None"; >;
uniform mat4 World : World < string UIWidget="None"; >;
uniform mat4 shadowViewPrj : ViewProjection < string UIWidget = "None"; >;

uniform vec2 ShadowFilterTaps[10] < string UIWidget = "None"; > = {{-0.84052, -0.073954}, {-0.326235, -0.40583}, {-0.698464, 0.457259}, {-0.203356, 0.620585}, {0.96345, -0.194353}, {0.473434, -0.480026}, {0.519454, 0.767034}, {0.185461, -0.894523}, {0.507351, 0.064963}, {-0.321932, 0.595435}};
 
uniform int Light0Type : LIGHTTYPE
<
	string UIName = "Light 0 Type";
	float UIMin = 0;
	float UIMax = 5;
	float UIStep = 1;
	string UIWidget = "None";
	string Object = "Light 0";
> = 3;

uniform vec3 Light0Color : LIGHTCOLOR
<
	string UIName = "Light 0 Color";
	string UIWidget = "ColorPicker";
	string Object = "Light 0";
> = {1.0, 1.0, 1.0};

uniform float Light0Intensity : LIGHTINTENSITY
<
	string UIName = "Light 0 Intensity";
	float UIMin = 0;
	float UIStep = 0.1;
	string Object = "Light 0";
> = 1.0;

uniform vec3 Light0Dir : DIRECTION
<
	string UIName = "Light 0 Direction";
	string Space = "World";
	string Object = "Light 0";
> = {0.0, -1.0, 0.0};


uniform bool Light0ShadowOn : SHADOWFLAG
<
	string UIName = "Light 0 Casts Shadow";
	string Object = "Light 0";
> = true;


uniform mat4 Light0ViewPrj : SHADOWMAPMATRIX
<
	string Object = "Light 0";
	string UIName = "Light 0 Matrix";
	string UIWidget = "None";
>;

uniform vec3 Light0ShadowColor : SHADOWCOLOR
<
	string UIName = "Light 0 Shadow Color";
	string Object = "Light 0";
> = {0, 0, 0};

uniform texture2D Light0ShadowMap : SHADOWMAP
<
	string ResourceName = "";
	string ResourceType = "2D";
	string UIWidget = "None";
	string Object = "Light 0";
	string UIName = "light0ShadowMap";
>;

uniform sampler2D Light0ShadowMapSampler = sampler_state 
{
	Texture = <Light0ShadowMap>;
	TEXTURE_MIN_FILTER = NEAREST;
	TEXTURE_MAG_FILTER = NEAREST;
	TEXTURE_WRAP_S = REPEAT;
	TEXTURE_WRAP_T = REPEAT;
	TEXTURE_WRAP_R = REPEAT;
};

//-----------------------------------------------------------------------------------------
// SHADOWS 
uniform float Light0ShadowBias : SHADOWMAPBIAS
<
    // string Object = "Light 0";
    string UIGroup = "Shadows";
    string UIName = "Light 0 ShadowBias";
    string UIWidget = "slider";
    float UIMin = 0;
	float UIMax = 1;
    int UIOrder = 0;
> = 0.01;

uniform float ShadowStrength 
<
    // string Object = "Light 0";
    string UIGroup = "Shadows";
	string UIWidget = "slider";
	string UIName = "Shadow Strength";
	float UIMin = 0;
	float UIMax = 1;
    int UIOrder = 1;
> = 0.6;


//-----------------------------------------------------------------------------------------
// PBR 
uniform vec3 AlbedoColor
<   
    string UIGroup = "PBR";
    string UIName = "Albedo";
	string UIWidget = "Color";
    int UIOrder = 10;
> = {1.0, 1.0, 1.0};

uniform bool AlbedoTexEnabled
<
    string UIGroup = "PBR";
    string UIName = "Albedo Texture";
    int UIOrder = 11;
> = false;

uniform texture2D AlbedoTexture
<
    string UIGroup = "PBR";
    string UIName = "Albedo Texture";
    string ResourceType = "2D";
    int UIOrder = 12;
>;

uniform sampler2D AlbedoSampler = sampler_state
{
    Texture = <AlbedoTexture>;
};

uniform bool NormalTexEnabled
<
    string UIGroup = "PBR";
    string UIName = "Normal Map";
    int UIOrder = 13;
> = false;

uniform texture2D NormalMapTexture
<
    string UIGroup = "PBR";
    string UIName = "Normal Map Texture";
    string ResourceType = "2D";
    int UIOrder = 14;
>;

uniform sampler2D NormalMapSampler = sampler_state
{
    Texture = <NormalMapTexture>;
};

uniform float NormalMapStrength 
<
    // string Object = "Light 0";
    string UIGroup = "PBR";
	string UIWidget = "slider";
	string UIName = "Normal Strength";
	float UIMin = 0;
	float UIMax = 10;
    int UIOrder = 15;
> = 1.0;

uniform float Metallic 
<
    // string Object = "Light 0";
    string UIGroup = "PBR";
	string UIWidget = "slider";
	string UIName = "Metallic";
	float UIMin = 0;
	float UIMax = 1;
    int UIOrder = 16;
> = 0.6;

uniform bool MetallicTexEnabled
<
    string UIGroup = "PBR";
    string UIName = "Metallic Texture";
    int UIOrder = 17;
> = false;

uniform texture2D MetallicTexture
<
    string UIGroup = "PBR";
    string UIName = "Metallic Texture";
    string ResourceType = "2D";
    int UIOrder = 18;
>;

uniform sampler2D MetallicSampler = sampler_state
{
    Texture = <MetallicTexture>;
};

uniform float Roughness 
<
    // string Object = "Light 0";
    string UIGroup = "PBR";
	string UIWidget = "slider";
	string UIName = "Roughness";
	float UIMin = 0;
	float UIMax = 1;
    int UIOrder = 19;
> = 0.6;

uniform bool RoughnessTexEnabled
<
    string UIGroup = "PBR";
    string UIName = "Roughness Texture";
    int UIOrder = 20;
> = false;

uniform texture2D RoughnessTexture
<
    string UIGroup = "PBR";
    string UIName = "Roughness Texture";
    string ResourceType = "2D";
    int UIOrder = 21;
>;

uniform sampler2D RoughnessSampler = sampler_state
{
    Texture = <RoughnessTexture>;
};

uniform float AO 
<
    // string Object = "Light 0";
    string UIGroup = "PBR";
	string UIWidget = "slider";
	string UIName = "AO";
	float UIMin = 0;
	float UIMax = 1;
    int UIOrder = 22;
> = 0.6;

uniform bool AOTexEnabled
<
    string UIGroup = "PBR";
    string UIName = "AO Texture";
    int UIOrder = 23;
> = false;

uniform texture2D AOTexture
<
    string UIGroup = "PBR";
    string UIName = "AO Texture";
    string ResourceType = "2D";
    int UIOrder = 24;
>;

uniform sampler2D AOSampler = sampler_state
{
    Texture = <AOTexture>;
};

uniform bool FresnelCtmEnabled
<
    string UIGroup = "PBR";
    string UIName = "Custom Fresnel";
    int UIOrder = 25;
> = false;


uniform vec3 FresnelColor
<
    string UIGroup = "PBR";
    string UIName = "Fresnel Color";
	string UIWidget = "Color";
    int UIOrder = 26;
> = {1.0, 1.0, 1.0};

uniform float FresnelPower 
<
    string UIGroup = "PBR";
	string UIWidget = "slider";
	string UIName = "Fresnel Strength";
	float UIMin = 0;
	float UIMax = 10;
    int UIOrder = 27;
> = 0.6;

uniform textureCube CubemapTexture
<
    string UIGroup = "PBR";
    string UIName = "IBL Cubemap";
    string ResourceType = "Cube";
    int UIOrder = 28;
>;

uniform samplerCube CubemapSampler = sampler_state
{
    Texture = <CubemapTexture>;
    TEXTURE_MIN_FILTER = LINEAR_MIPMAP_LINEAR;
    TEXTURE_MAG_FILTER = LINEAR;
};



attribute appdata {
    vec4 aPosition    : POSITION;
    vec3 aNormal    : NORMAL;
    vec2 aUV : TEXCOORD0;
};

attribute vOutput {
    vec2 outUV : TEXCOORD0;
    vec4 outWorldNormal : NORMAL;
    vec4 outWorldPos : POSITION;
    vec4 outCameraPos : TEXCOORD1;
};

attribute fOutput 
{
    vec4 outColor : COLOR0;
}

GLSLShader VS
{
    void main()
    {
        outWorldPos = World * aPosition;
        outWorldNormal = (WorldInverseTranspose, vec4(aNormal.xyz, 0.0));
        outCameraPos = vec4(ViewInverse[3].xyz, 1.0);
        outUV = vec2(aUV.x, 1.0 - aUV.y);
        gl_Position = WorldViewProjection * aPosition;
    }
}

GLSLShader FS
{
    const float PI = 3.14159265359;

    float ComputeShadowMap(vec3 worldPos)
    {
		float IfElseOp199 = 0.0;
		vec4 VectorConstruct = vec4(worldPos.x, worldPos.y, worldPos.z, 1.0);
		vec4 MulOp = (Light0ViewPrj * VectorConstruct);
		vec3 DivOp = (MulOp.xyz / MulOp.w);
		if (DivOp.x > -1.0 && DivOp.x < 1.0 && DivOp.y > -1.0 && DivOp.y < 1.0 && DivOp.z > 0.0 && DivOp.z < 1.0)
		{
			float Val = 0.5;
			vec2 AddOp = ((Val * DivOp.xy) + Val);
			float SubOp = (DivOp.z - (Light0ShadowBias / MulOp.w));
			float ShadowTotal = 0.0;
			for(int i=0; i<10; i+=1)
			{
				vec2 MulOp239 = (0.0009 * ShadowFilterTaps[i]);
				vec4 Sampler = textureLod(Light0ShadowMapSampler, (AddOp + MulOp239), 0);
				float IfElseOp193 = ((SubOp - Sampler.x) >= 0.0) ? (0.0) : (0.1);
				ShadowTotal += IfElseOp193;
			}
			ShadowTotal = mix(1.0, ShadowTotal, 1.0);  
			IfElseOp199 = ShadowTotal;
		}
		else
		{
			IfElseOp199 = 1.0;
		}

		return lerp(1.0, IfElseOp199, ShadowStrength);
    }

    float ComputeShadowMapDepth(vec4 worldPos)
    {
		vec4 MulOp = (shadowViewPrj * worldPos);
		float DepthPerPixel = (MulOp.z / MulOp.w);
		float AddOp = (DepthPerPixel + fwidth(DepthPerPixel));
		float NormalMap = (0.5 * AddOp);
		float AddOp993 = (NormalMap + 0.5);

		return AddOp993;
    }

    vec3 GetNormalFromTexture(vec2 uv, vec3 worldPos, vec3 normal, sampler2D normalSampler)
    {
        vec3 tangentNormal = texture(normalSampler, uv).xyz * 2.0 - 1.0;
        tangentNormal.xy *= NormalMapStrength;
        vec3 Q1  = dFdx(worldPos);
        vec3 Q2  = dFdy(worldPos);
        vec2 st1 = dFdx(uv);
        vec2 st2 = dFdy(uv);

        vec3 N   = normalize(normal);
        vec3 T  = normalize(Q1*st2.t - Q2*st1.t);
        vec3 B  = -normalize(cross(N, T));
        mat3 TBN = mat3(T, B, N);

        return normalize(TBN * tangentNormal);
    }

    float DistributionGGX(vec3 N, vec3 H, float roughness)
    {
        float a = roughness * roughness;
        float a2 = a * a;
        float NdotH = max(dot(N, H), 0.0);
        float NdotH2 = NdotH*NdotH;

        float nom   = a2;
        float denom = (NdotH2 * (a2 - 1.0) + 1.0);

        denom = PI * denom * denom;

        return nom / denom;
    }

    float GeometrySchlickGGX(float NdotV, float roughness)
    {
        float r = (roughness + 1.0);
        float k = (r*r) / 8.0;

        float nom   = NdotV;
        float denom = NdotV * (1.0 - k) + k;

        return nom / denom;
    }

    float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
    {
        float NdotV = max(dot(N, V), 0.0);
        float NdotL = max(dot(N, L), 0.0);
        float ggx2 = GeometrySchlickGGX(NdotV, roughness);
        float ggx1 = GeometrySchlickGGX(NdotL, roughness);

        return ggx1 * ggx2;
    }

    vec3 fresnelSchlick(float cosTheta, vec3 F0)
    {
        return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
    }

    void main()
    {
        vec3 N = normalize(outWorldNormal).xyz;
        vec3 V = normalize(outCameraPos.xyz - outWorldPos.xyz);
        vec3 lightDir = normalize(-Light0Dir);

        vec2 uv = outUV;

        vec3 albedo = AlbedoColor;
        float metallic = Metallic;
        float roughness = Roughness;
        float ao = AO;
        
        if (AlbedoTexEnabled) {
            albedo = pow(texture(AlbedoSampler, uv).rgb, vec3(2.2));
        }

        if (MetallicTexEnabled) {
            metallic = texture(MetallicSampler, uv).r;
        }

        if (RoughnessTexEnabled) {
            roughness = texture(RoughnessSampler, uv).r;
        }

        if (AOTexEnabled) {
            ao = texture(AOSampler, uv).r;
        }

        if (NormalTexEnabled) {
            N = GetNormalFromTexture(uv, outWorldPos.xyz, outWorldNormal.xyz, NormalMapSampler);
        }

        // calculate reflectance at normal incidence; if dia-electric (like plastic) use F0 
        // of 0.04 and if it's a metal, use the albedo color as F0 (metallic workflow)    
        vec3 F0 = vec3(0.04);
        F0 = mix(F0, albedo, metallic);

        // reflectance equation
        vec3 Lo = vec3(0.0);
        vec3 L = (lightDir);
        vec3 H = normalize(V + L);
        vec3 radiance = Light0Color;

        // Cook-Torrance BRDF
        float NDF = DistributionGGX(N, H, roughness);   
        float G   = GeometrySmith(N, V, L, roughness);      
        vec3 F    = fresnelSchlick(clamp(dot(H, V), 0.0, 1.0), F0);
        
        if (FresnelCtmEnabled) {
            float fresnel = pow(clamp(dot(V, N), 0.0, 1.0), FresnelPower);
            F = fresnelSchlick(fresnel, F0);
            
        }

        F *= FresnelColor;
        vec3 numerator    = NDF * G * F; 
        float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) + 0.0001; // + 0.0001 to prevent divide by zero
        vec3 specular = numerator / denominator;

        vec3 kS = F;

        vec3 kD = vec3(1.0) - kS;
        kD *= 1.0 - metallic;
        float NdotL = max(dot(N, L), 0.0);   
        Lo += (kD * albedo / PI + specular) * radiance * NdotL;

        vec3 ambient = vec3(0.03) * albedo * ao;

        vec3 color = ambient + Lo;
        color = color / (color + vec3(1.0));
        color = pow(color, vec3(1.0/2.2)); 

        float shadowMap = ComputeShadowMap(outWorldPos.xyz);

        outColor = vec4(color, 1.0);
        outColor *= Light0Intensity * shadowMap;
    }
}

technique Opaque
{
    pass p0
    {
        VertexShader (in appdata, out vOutput) = VS;
        PixelShader (in vOutput, out fOutput) = FS;
    }
}


technique Transparent
<
    string Transparency = "Transparent";
>
{
    pass p0
    {
        VertexShader (in appdata, out vOutput) = VS;
        PixelShader (in vOutput, out fOutput) = FS;
    }
}