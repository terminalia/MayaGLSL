//###################################################################
// MATRICES
//
// Matrices coming from application (Maya)
//###################################################################

uniform mat4 WorldViewProjection : WorldViewProjection < string UIWidget="None"; >;
uniform mat4 WorldInverseTranspose : WorldInverseTranspose < string UIWidget="None"; >;
uniform mat4 ViewInverse : ViewInverse < string UIWidget="None"; >;
uniform mat4 World : World < string UIWidget="None"; >;
uniform mat4 shadowViewPrj : ViewProjection < string UIWidget = "None"; >;

uniform vec2 ShadowFilterTaps[10] < string UIWidget = "None"; > = {{-0.84052, -0.073954}, {-0.326235, -0.40583}, {-0.698464, 0.457259}, {-0.203356, 0.620585}, {0.96345, -0.194353}, {0.473434, -0.480026}, {0.519454, 0.767034}, {0.185461, -0.894523}, {0.507351, 0.064963}, {-0.321932, 0.595435}};
 
 //Animation time
uniform float time : Time
<
    string UIWidget = "None";
>;


uniform int Light0Type : LIGHTTYPE
<
	string UIName = "Light 0 Type";
	float UIMin = 0;
	float UIMax = 5;
	float UIStep = 1;
	string UIWidget = "None";
	string Object = "Light 0";
> = 3;

uniform vec3 Light0Color : LIGHTCOLOR
<
	string UIName = "Light 0 Color";
	string UIWidget = "ColorPicker";
	string Object = "Light 0";
> = {1.0, 1.0, 1.0};

uniform float Light0Intensity : LIGHTINTENSITY
<
	string UIName = "Light 0 Intensity";
	float UIMin = 0;
	float UIStep = 0.1;
	string Object = "Light 0";
> = 1.0;

uniform vec3 Light0Dir : DIRECTION
<
	string UIName = "Light 0 Direction";
	string Space = "World";
	string Object = "Light 0";
> = {0.0, -1.0, 0.0};


uniform bool Light0ShadowOn : SHADOWFLAG
<
	string UIName = "Light 0 Casts Shadow";
	string Object = "Light 0";
> = true;


uniform mat4 Light0ViewPrj : SHADOWMAPMATRIX
<
	string Object = "Light 0";
	string UIName = "Light 0 Matrix";
	string UIWidget = "None";
>;



uniform vec3 Light0ShadowColor : SHADOWCOLOR
<
	string UIName = "Light 0 Shadow Color";
	string Object = "Light 0";
> = {0, 0, 0};

uniform texture2D Light0ShadowMap : SHADOWMAP
<
	string ResourceName = "";
	string ResourceType = "2D";
	string UIWidget = "None";
	string Object = "Light 0";
	string UIName = "light0ShadowMap";
>;

uniform sampler2D Light0ShadowMapSampler = sampler_state 
{
	Texture = <Light0ShadowMap>;
	TEXTURE_MIN_FILTER = NEAREST;
	TEXTURE_MAG_FILTER = NEAREST;
	TEXTURE_WRAP_S = REPEAT;
	TEXTURE_WRAP_T = REPEAT;
	TEXTURE_WRAP_R = REPEAT;
};

uniform float Light0ShadowBias : SHADOWMAPBIAS
<
    // string Object = "Light 0";
	string UIGroup = "Shadows";
    string UIName = "Light 0 ShadowBias";
    string UIWidget = "slider";
    float UIMin = 0;
	float UIMax = 1;
	int UIOrder = 0;
> = 0.01;

uniform float ShadowStrength 
<
	string UIGroup = "Shadows";
	string UIWidget = "slider";
	string UIName = "Shadow Strength";
	float UIMin = 0;
	float UIMax = 1;
	int UIOrder = 1;
> = 0.6;

uniform vec3 DiffuseColor
<   
    string UIGroup = "Diffuse";
    string UIName = "Diffuse Color";
	string UIWidget = "Color";
	int UIOrder = 10;
> = {1.0, 1.0, 1.0};


uniform texture2D DisplacementTexture
<
    string UIGroup = "Displacement";
    string UIName = "Displacement Texture";
    string ResourceType = "2D";
    int UIOrder = 20;
>;

uniform sampler2D DisplacementSampler = sampler_state
{
    Texture = <DisplacementTexture>;
};

uniform float DisplacementAmount 
<
    string UIGroup = "Displacement";
	string UIWidget = "slider";
	string UIName = "Displacement Amount";
	float UIMin = 0;
	float UIMax = 1;
	int UIOrder = 21;
> = 0.6;

//-------------------------------------------------------------------------------------
// UV MANIPULATION
uniform vec2 uvSpeedXY 
<
    string UIGroup = "UV Settings";
	string UIName = "UV Animation Speed";
    int UIOrder = 60;
> = {0.0f, 0.0f};

uniform float uvTileX 
<
    string UIGroup = "UV Settings";
    string UIWidget = "slider";
	string UIName = "UV Tile X";
    float UIMin = 1;
	float UIMax = 10;
    int UIOrder = 61;
> = 1.0f;

uniform float uvTileY
<
    string UIGroup = "UV Settings";
    string UIWidget = "slider";
	string UIName = "UV Tile Y";
    float UIMin = 1;
	float UIMax = 10;
    int UIOrder = 62;
> = 1.0f;

uniform float uvOffsetX
<
    string UIGroup = "UV Settings";
    string UIWidget = "slider";
	string UIName = "UV Offset X";
    float UIMin = 0;
	float UIMax = 10;
    int UIOrder = 63;
> = 0.0f;

uniform float uvOffsetY
<
    string UIGroup = "UV Settings";
    string UIWidget = "slider";
	string UIName = "UV Offset Y";
    float UIMin = 0;
	float UIMax = 10;
    int UIOrder = 64;
> = 0.0f;


attribute appdata {
    vec4 aPosition    : POSITION;
	vec2 aUV : TEXCOORD0;
    vec3 aNormal    : NORMAL;
	vec3 aTangent : TANGENT;
};

attribute vOutput {
	vec2 outUV : TEXCOORD0;
    vec4 outWorldNormal : NORMAL;
    vec4 outWorldPos : TEXCOORD0;
};

attribute fOutput 
{
    vec4 outColor : COLOR0;
}

GLSLShader VS
{


    void main()
    {
		vec4 inPosition = aPosition;

		outUV = vec2(aUV.x, 1.0 - aUV.y);
		vec2 uv = outUV * vec2(uvTileX, uvTileY) + vec2(uvOffsetX * 0.1, uvOffsetY * 0.1) + (time * uvSpeedXY);;
        

		vec4 displacementTex = textureLod(DisplacementSampler, uv, 0.0);

		inPosition.xyz += aNormal * displacementTex.r * DisplacementAmount;

		vec3 bitangent = cross(aNormal, aTangent);

		vec3 posTangent = inPosition.xyz + aTangent * 0.01;
		//We don't apply DisplacementAmount in normal because otherwise the lighting would be 0 if DisplacementAmount is 0
		vec3 modPosTangent = posTangent + aNormal * displacementTex.r;

		vec3 posBitangent = inPosition.xyz + bitangent * 0.01;
		//We don't apply DisplacementAmount in normal because otherwise the lighting would be 0 if DisplacementAmount is 0
		vec3 modPosBitangent = posBitangent + aNormal * displacementTex.r;

		modPosTangent -= inPosition.xyz;
		modPosBitangent -= inPosition.xyz;

		vec3 modNormal = (modPosTangent, modPosBitangent);
		outWorldNormal = vec4(modNormal, 0.0);

        outWorldPos = World * inPosition;
        gl_Position = WorldViewProjection * inPosition;
    }
}

GLSLShader FS
{

    float ComputeShadowMap(vec3 worldPos)
    {
		float IfElseOp199 = 0.0;
		vec4 VectorConstruct = vec4(worldPos.x, worldPos.y, worldPos.z, 1.0);
		vec4 MulOp = (Light0ViewPrj * VectorConstruct);
		vec3 DivOp = (MulOp.xyz / MulOp.w);
		if (DivOp.x > -1.0 && DivOp.x < 1.0 && DivOp.y > -1.0 && DivOp.y < 1.0 && DivOp.z > 0.0 && DivOp.z < 1.0)
		{
			float Val = 0.5;
			vec2 AddOp = ((Val * DivOp.xy) + Val);
			float SubOp = (DivOp.z - (Light0ShadowBias / MulOp.w));
			float ShadowTotal = 0.0;
			for(int i=0; i<10; i+=1)
			{
				vec2 MulOp239 = (0.0009 * ShadowFilterTaps[i]);
				vec4 Sampler = textureLod(Light0ShadowMapSampler, (AddOp + MulOp239), 0);
				float IfElseOp193 = ((SubOp - Sampler.x) >= 0.0) ? (0.0) : (0.1);
				ShadowTotal += IfElseOp193;
			}
			ShadowTotal = mix(1.0, ShadowTotal, 1.0);  
			IfElseOp199 = ShadowTotal;
		}
		else
		{
			IfElseOp199 = 1.0;
		}

		return lerp(1.0, IfElseOp199, ShadowStrength);
    }

    float ComputeShadowMapDepth(vec4 worldPos)
    {
		vec4 MulOp = (shadowViewPrj * worldPos);
		float DepthPerPixel = (MulOp.z / MulOp.w);
		float AddOp = (DepthPerPixel + fwidth(DepthPerPixel));
		float NormalMap = (0.5 * AddOp);
		float AddOp993 = (NormalMap + 0.5);

		return AddOp993;
    }

    void main()
    {
        vec3 worldNormal = outWorldNormal.xyz;
		vec3 lightDir = normalize(-Light0Dir);

        float diff = clamp(dot(worldNormal, lightDir), 0.0, 1.0);
        vec3 diffuse = (diff * DiffuseColor.rgb);

        float shadowMap = ComputeShadowMap(outWorldPos.xyz);
        vec3 DiffuseSpec = shadowMap * diffuse;

        outColor.rgb = DiffuseSpec;
        outColor.a = 1.0;
    }
}


technique Opaque
{
    pass p0
    {
        VertexShader (in appdata, out vOutput) = VS;
        PixelShader (in vOutput, out fOutput) = FS;
    }
}

technique Transparent
<
    string Transparency = "Transparent";
>
{
    pass p0
    {
        VertexShader (in appdata, out vOutput) = VS;
        PixelShader (in vOutput, out fOutput) = FS;
    }
}