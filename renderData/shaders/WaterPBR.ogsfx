attribute appdata {
    vec4 aPosition    : POSITION;
    vec3 aNormal    : NORMAL;
    vec2 aUV : TEXCOORD0;
};

attribute vOutput {
    vec2 outUV : TEXCOORD0;
    vec4 outWorldNormal : NORMAL;
    vec4 outWorldPos : TEXCOORD1;
    vec4 outCameraPos : TEXCOORD2;
    vec4 outVertColor : COLOR;
    float outYDepth;
};

attribute fOutput 
{
    vec4 outColor : COLOR0;
}

GLSLShader VS
{
    vec3 calc_normal(vec2 uv, float height_range, sampler2D displacementTex) {
		vec2 texelSize = 1.0 / vec2(textureSize(displacementTex, 0));
		float left = texture(displacementTex, uv + vec2(texelSize * vec2(-1.0, 0.0))).r * height_range;
		float right = texture(displacementTex, uv + vec2(texelSize * vec2(1.0, 0.0))).r * height_range;
		float up = texture(displacementTex, uv + vec2(texelSize * vec2(0.0, -1.0))).r * height_range;
		float down = texture(displacementTex, uv + vec2(texelSize * vec2(0.0, 1.0))).r * height_range;

		return normalize(vec3(left - right, 2.0 * texelSize.x, up - down));
	}

    float remap(float s) {
        return (s + 1.0) / 2.0;
    }

    void main()
    {
        vec4 inPosition = aPosition;

        outUV = vec2(aUV.x, 1.0 - aUV.y);
        vec2 uv = outUV * vec2(uvTileX, uvTileY) + vec2(uvOffsetX * 0.1, uvOffsetY * 0.1) + (time * uvSpeedXY);;
        vec4 displacementTex = textureLod(DisplacementSampler, uv, 1.0);
        inPosition.xyz += aNormal * displacementTex.r * DisplacementAmount;

        outWorldPos = World * inPosition;
        vec4 farPos = World * vec4(inPosition.x, FarObjectHeight, inPosition.z, 1.0);
        float dist = distance(normalize(outWorldPos), normalize(farPos));
        outYDepth = clamp(dist, 0.0, 1.0);
        outWorldNormal = (WorldInverseTranspose, vec4(aNormal.xyz, 0.0));
        //outWorldNormal = vec4(calc_normal(uv, DisplacementAmount, DisplacementSampler), 0);
        
        outCameraPos = vec4(ViewInverse[3].xyz, 1.0);

        outVertColor = inPosition;
        float remapped = remap((aNormal + displacementTex.xyz).r);
        outVertColor = vec4(remapped, remapped, remapped, 1);

        gl_Position = WorldViewProjection * inPosition;
    }
}

GLSLShader FS
{

    const float MinRoughnes = 0.04;

    float ComputeShadowMap(vec3 worldPos)
    {
		float IfElseOp199 = 0.0;
		vec4 VectorConstruct = vec4(worldPos.x, worldPos.y, worldPos.z, 1.0);
		vec4 MulOp = (Light0ViewPrj * VectorConstruct);
		vec3 DivOp = (MulOp.xyz / MulOp.w);
		if (DivOp.x > -1.0 && DivOp.x < 1.0 && DivOp.y > -1.0 && DivOp.y < 1.0 && DivOp.z > 0.0 && DivOp.z < 1.0)
		{
			float Val = 0.5;
			vec2 AddOp = ((Val * DivOp.xy) + Val);
			float SubOp = (DivOp.z - (Light0ShadowBias / MulOp.w));
			float ShadowTotal = 0.0;
			for(int i=0; i<10; i+=1)
			{
				vec2 MulOp239 = (0.0009 * ShadowFilterTaps[i]);
				vec4 Sampler = textureLod(Light0ShadowMapSampler, (AddOp + MulOp239), 0);
				float IfElseOp193 = ((SubOp - Sampler.x) >= 0.0) ? (0.0) : (0.1);
				ShadowTotal += IfElseOp193;
			}
			ShadowTotal = mix(1.0, ShadowTotal, 1.0);  
			IfElseOp199 = ShadowTotal;
		}
		else
		{
			IfElseOp199 = 1.0;
		}

		return lerp(1.0, IfElseOp199, ShadowStrength);
    }

    float ComputeShadowMapDepth(vec4 worldPos)
    {
		vec4 MulOp = (shadowViewPrj * worldPos);
		float DepthPerPixel = (MulOp.z / MulOp.w);
		float AddOp = (DepthPerPixel + fwidth(DepthPerPixel));
		float NormalMap = (0.5 * AddOp);
		float AddOp993 = (NormalMap + 0.5);

		return AddOp993;
    }

    vec3 GetNormalFromTexture(vec2 uv, vec3 worldPos, vec3 normal, sampler2D normalSampler)
    {
        vec3 tangentNormal = texture(normalSampler, uv).xyz * 2.0 - 1.0;
        tangentNormal.xy *= NormalMapStrength;
        vec3 Q1  = dFdx(worldPos);
        vec3 Q2  = dFdy(worldPos);
        vec2 st1 = dFdx(uv);
        vec2 st2 = dFdy(uv);

        vec3 N   = normalize(normal);
        vec3 T  = normalize(Q1*st2.t - Q2*st1.t);
        vec3 B  = -normalize(cross(N, T));
        mat3 TBN = mat3(T, B, N);

        return normalize(TBN * tangentNormal);
    }

    float DistributionGGX(vec3 N, vec3 H, float roughness)
    {
        float a = roughness * roughness;
        float a2 = a * a;
        float NdotH = max(dot(N, H), 0.0);
        float NdotH2 = NdotH*NdotH;

        float nom   = a2;
        float denom = (NdotH2 * (a2 - 1.0) + 1.0);

        denom = M_PI * denom * denom;

        return nom / denom;
    }

    float GeometrySchlickGGX(float NdotV, float roughness)
    {
        float r = (roughness + 1.0);
        float k = (r*r) / 8.0;

        float nom   = NdotV;
        float denom = NdotV * (1.0 - k) + k;

        return nom / denom;
    }

    float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
    {
        float NdotV = max(dot(N, V), 0.0);
        float NdotL = max(dot(N, L), 0.0);
        float ggx2 = GeometrySchlickGGX(NdotV, roughness);
        float ggx1 = GeometrySchlickGGX(NdotL, roughness);

        return ggx1 * ggx2;
    }

    vec3 fresnelSchlick(float cosTheta, vec3 F0)
    {
        return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
    }

    vec4 RGBMDecode(vec4 rgbm, bool isEncoded) 
    {
        return isEncoded ? vec4(6.0 * rgbm.rgb * rgbm.a, rgbm.a) : rgbm;
    }

    vec3 colorize(vec3 p)
    {
        return sign(p) * pow(abs(p), vec3(1)) * 0.5 + vec3(0.5);
    }

    vec4 SRGBtoLINEAR(vec4 srgbIn)
    {
        vec3 linOut = pow(srgbIn.xyz,vec3(2.2));
        return vec4(linOut,srgbIn.w);;
    }

    vec4 SRGBtoLINEAR(vec4 colorIn, bool isSRGB)
    {
        return isSRGB ? SRGBtoLINEAR(colorIn) : colorIn;
    }

    vec4 tex2D(sampler2D s, vec2 uv, vec4 defaultColor)
    {
        return textureSize(s, 0).x > 1 ? texture(s, uv) : defaultColor;
    }

    vec3 rotateAboutY(vec3 v, float degrees)
    {
        float angle =degrees * M_PI / 180.0;
        float ca = cos(angle);
        float sa = sin(angle);
        return vec3(v.x * ca + v.z * sa, v.y, v.z * ca-v.x * sa);
    }

    float BurleyToMipSimple(float fPerceptualRoughness, float nMipMax)
    {
        // https://docs.knaldtech.com/doku.php?id=specular_lys
        // approximate remap from LdotR based distribution to NdotH
        float fScale = fPerceptualRoughness*((1+BurleyFactor) - BurleyFactor*fPerceptualRoughness);    
        return fScale * nMipMax;
    }

    vec3 texEnvSpecular(vec3 v, float roughness)
    {
        vec4 color = vec4(0);

        // HACK: It seems Maya passes a single pixel texture when no texture is assigned
        if (textureSize(SpecularEnvSampler, 0).x > 1)
        {
            //int mipMapCount = textureQueryLevels(u_SpecularEnvSampler);
            
            float mipMax = max(0, MipMapCount - 1);
            float lod = BurleyToMipSimple(roughness, mipMax);
            
            v = rotateAboutY(v, EnvRotAngle);

            color = textureLod(SpecularEnvSampler, v, lod);

            color = SRGBtoLINEAR(RGBMDecode(color, false), EnvironmentSRGBEnabled);
        }

        return color.rgb;
    }

    vec3 texEnvDiffuse(vec3 v)
    {
        vec4 color = vec4(0);

        // HACK: It seems Maya passes a single pixel texture when no texture is assigned
        int size = textureSize(EnvironmentSampler, 0).x;
        if (size > 1)
        {
            // TODO: Diffuse LOD
            const float lod = 0;

            v = rotateAboutY(v, EnvRotAngle);


            color = textureLod(EnvironmentSampler, v, lod);
            color = SRGBtoLINEAR(RGBMDecode(color, false), false);
        }

        return color.rgb;
    }

    vec3 ComputeIBLContribution(float NdotV, vec3 albedo, vec3 specularColor, vec3 n, vec3 reflection, float roughness)
    {
        vec3 brdf = SRGBtoLINEAR(tex2D(BrdfSampler, vec2(NdotV, 1.0 - roughness), vec4(0)), EnvironmentSRGBEnabled).rgb;
        vec3 diffuseLight = texEnvDiffuse(n);
        vec3 specularLight = texEnvSpecular(reflection, roughness);

        vec3 diffuse = diffuseLight * albedo;
        vec3 specular = specularLight * (specularColor * brdf.x + brdf.y);


        return diffuse + specular;
    }

    vec3 calc_normal(vec2 uv, float height_range, sampler2D displacementTex) {
		vec2 texelSize = 1.0 / vec2(textureSize(displacementTex, 0));
		float left = texture(displacementTex, uv + vec2(texelSize * vec2(-1.0, 0.0))).r * height_range;
		float right = texture(displacementTex, uv + vec2(texelSize * vec2(1.0, 0.0))).r * height_range;
		float up = texture(displacementTex, uv + vec2(texelSize * vec2(0.0, -1.0))).r * height_range;
		float down = texture(displacementTex, uv + vec2(texelSize * vec2(0.0, 1.0))).r * height_range;

		return normalize(vec3(left - right, 2.0 * texelSize.x, up - down));
	}


    void main()
    {   
        vec2 uv = outUV;
        uv = outUV * vec2(uvTileX, uvTileY) + vec2(uvOffsetX * 0.1, uvOffsetY * 0.1) + (time * uvSpeedXY);;
        
        vec3 Normal = calc_normal(uv, DisplacementAmount, DisplacementSampler);

        vec3 N = normalize(Normal).xyz;
        vec3 V = normalize(outCameraPos.xyz - outWorldPos.xyz);
        vec3 lightDir = normalize(-Light0Dir);
        vec3 reflectionVector = normalize(-reflect(V, N));
        
        vec4 gradientTex = texture(GradientSampler, vec2(outVertColor.x *  GradientOffset, 0.0));

        
        vec3 albedo = AlbedoColor;
        float metallic = Metallic;
        float roughness = Roughness;
        float ao = AO;
        
        // if (AlbedoTexEnabled) {
        //     vec4 srgbTex = SRGBtoLINEAR(texture(AlbedoSampler, uv), AlbedoSRGEnabled);
        //     albedo = pow(srgbTex.rgb, vec3(2.2));
        //     albedo = pow(lerp(albedo.rgb, gradientTex.rgb, 1.0), vec3(2.2));
        // }

        albedo = pow(lerp(albedo.rgb, gradientTex.rgb, outYDepth), vec3(2.2));

        if (MetallicTexEnabled) {
            metallic = texture(MetallicSampler, uv).r * Metallic;
        }

        if (RoughnessTexEnabled) {
            roughness = texture(RoughnessSampler, uv).r * Roughness;
        }

        if (AOTexEnabled) {
            ao = texture(AOSampler, uv).r;
        }

        if (NormalTexEnabled) {
            N = GetNormalFromTexture(uv, outWorldPos.xyz, Normal.xyz, NormalMapSampler);
        }

        // calculate reflectance at normal incidence; if dia-electric (like plastic) use F0 
        // of 0.04 and if it's a metal, use the albedo color as F0 (metallic workflow)    
        vec3 F0 = vec3(0.04);
        F0 = mix(F0, albedo, metallic);

        // reflectance equation
        vec3 Lo = vec3(0.0);
        vec3 L = (lightDir);
        vec3 H = normalize(V + L);
        vec3 radiance = Light0Color;

        // Cook-Torrance BRDF
        float NDF = DistributionGGX(N, H, roughness);   
        float G   = GeometrySmith(N, V, L, roughness);      
        vec3 F    = fresnelSchlick(clamp(dot(H, V), 0.0, 1.0), F0);
        
        if (FresnelCtmEnabled) {
            float fresnel = pow(clamp(dot(V, N), 0.0, 1.0), FresnelPower);
            F = fresnelSchlick(fresnel, F0);
            
        }

        F *= FresnelColor;
        vec3 numerator    = NDF * G * F; 
        float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) + 0.0001; // + 0.0001 to prevent divide by zero
        vec3 specular = numerator / denominator;

        vec3 kS = F;

        vec3 kD = vec3(1.0) - kS;
        kD *= 1.0 - metallic;
        float NdotL = max(dot(N, L), 0.0);   
        Lo += (kD * albedo / M_PI + specular) * radiance * NdotL;

        vec3 ambient = vec3(0.03) * albedo * ao;

        vec3 color = ambient + Lo;
        color = color / (color + vec3(1.0));
        color = pow(color, vec3(1.0/2.2)); 

        float shadowMap = ComputeShadowMap(outWorldPos.xyz);


        vec3 specularColor = mix(F0, albedo, metallic);
        vec3 ibl = ComputeIBLContribution(dot(N,V), albedo, specularColor, N, reflectionVector, roughness);


        outColor = vec4(color, 1.0);
        outColor.rgb += ibl;
        outColor *= Light0Intensity * shadowMap * outYDepth;
        outColor.a = OpacityStrength * outYDepth;
    }
}

GLSLShader FSDepth
{

    void main()
    {
        float yDepth = 1 - outYDepth;
        outColor = vec4(yDepth, yDepth, yDepth, 1.0);
    }
}

technique Opaque
{
    pass p0
    {
        VertexShader (in appdata, out vOutput) = VS;
        PixelShader (in vOutput, out fOutput) = FS;
    }
}

technique Depth
{
    pass p0
    {
        VertexShader (in appdata, out vOutput) = VS;
        PixelShader (in vOutput, out fOutput) = FSDepth;
    }
}

technique Transparent
<
    string Transparency = "Transparent";
>
{
    pass p0
    {
        VertexShader (in appdata, out vOutput) = VS;
        PixelShader (in vOutput, out fOutput) = FS;
    }
}